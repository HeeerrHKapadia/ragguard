# Copy this file to `.env` and adjust if needed.
#   cp .env.example .env      (or `Copy-Item .env.example .env` in PowerShell)
#
# `.env` is gitignored. `.env.example` is committed, so anyone cloning the
# repo knows which variables exist without ever seeing your values. Get in
# this habit now — leaked credentials in git history are forever.

POSTGRES_USER=ragguard
POSTGRES_PASSWORD=ragguard_dev_pw
POSTGRES_DB=ragguard

# Host-side port. Container-internal is always 5432.
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Must match the vector(N) dimension in db/init/02_schema.sql.
# Changing the model means recreating the volume: docker compose down -v
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
